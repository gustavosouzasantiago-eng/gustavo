* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #05050a;
    color: #e0e0e0;
    line-height: 1.6;
    padding: 20px;
}

header {
    text-align: center;
    padding: 60px 20px;
    background: linear-gradient(135deg, #0b091a 0%, #1a0b2e 100%);
    border-radius: 12px;
    margin-bottom: 40px;
    box-shadow: 0 0 20px rgba(111, 45, 168, 0.2);
}

header h1 {
    font-size: 3rem;
    color: #fff;
    margin-bottom: 10px;
    letter-spacing: 2px;
    text-shadow: 0 0 10px rgba(147, 51, 234, 0.5);
}

header p {
    font-size: 1.2rem;
    color: #a78bfa;
}

.container {
    max-width: 900px;
    margin: 0 auto;
}

.card {
    background: #12121f;
    padding: 30px;
    margin-bottom: 30px;
    border-radius: 10px;
    border: 1px solid #2a1b4e;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
}

.card h2 {
    color: #c084fc;
    margin-bottom: 15px;
    font-size: 1.8rem;
    border-bottom: 2px solid #2a1b4e;
    padding-bottom: 8px;
}

.card p, .card ul {
    margin-bottom: 15px;
}

.card ul {
    padding-left: 20px;
}

.card li {
    margin-bottom: 8px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.sub-card {
    background: #1a1a2e;
    padding: 20px;
    border-radius: 8px;
    border-left: 4px solid #9333ea;
}

.sub-card h3 {
    color: #e9d5ff;
    margin-bottom: 8px;
}

footer {
    text-align: center;
    padding: 20px;
    margin-top: 40px;
    color: #6b7280;
    font-size: 0.9rem;
}